# Postgres connection string. In production this points at Neon; for local dev, any
# Postgres 16+ works (the exclusion-constraint migration needs the btree_gist extension,
# which Neon has available — see prisma/migrations for the CREATE EXTENSION statement).
# Neon example: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://shiftsync:shiftsync_dev_pw@localhost:5433/shiftsync?schema=public"

# Any long random string in production. Do not reuse this value.
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="12h"

PORT=4000

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS="http://localhost:5173"
